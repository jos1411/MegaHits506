@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "~/Views/Shared/_LayoutAcceso.cshtml";
}

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg-secondary)">
    <div style="width:100%;max-width:420px;padding:20px">
        <div class="card-mega">
            <div class="card-head" style="text-align:center;font-size:20px">
                🎵 Mega Hits 506
            </div>
            <div class="card-body-mega">
                <p style="color:var(--text-secondary);text-align:center;margin-bottom:24px">
                    Iniciá sesión para continuar
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert-mega error mb-3">@ViewBag.Error</div>
                }

                @using (Html.BeginForm("Login", "Acceso", FormMethod.Post))
                {
                    <div class="form-mega">
                        <div class="mb-3">
                            <label>Correo electrónico</label>
                            <input type="email" name="correo"
                                   placeholder="correo@ejemplo.com" required />
                        </div>
                        <div class="mb-3">
                            <label>Contraseña</label>
                            <input type="password" name="clave"
                                   placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn-blue"
                                style="width:100%;padding:12px;font-size:15px;margin-top:8px">
                            Ingresar
                        </button>
                    </div>
                }

                <p style="text-align:center;margin-top:20px;font-size:14px;color:var(--text-secondary)">
                    ¿No tenés cuenta?
                    <a href="/Acceso/Registro" style="color:var(--color-blue)">Registrarse</a>
                </p>
            </div>
        </div>
    </div>
</div>