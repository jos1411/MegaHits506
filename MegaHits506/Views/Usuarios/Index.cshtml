@model List<MegaHits506.Models.Usuario>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert-mega success mb-4">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-mega error mb-4">@TempData["Error"]</div>
}

<div class="card-mega">
    <div class="card-head d-flex justify-content-between align-items-center">
        <span>👤 Gestión de Usuarios</span>
        <a href="/Usuarios/Crear" class="btn-blue">+ Nuevo Usuario</a>
    </div>
    <div class="card-body-mega">
        <div class="tabla-admin-wrapper">
            <table class="table-mega">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="#">@item.Identificador</td>
                            <td data-label="Nombre">@item.NombreCompleto</td>
                            <td data-label="Correo">@item.Correo</td>
                            <td data-label="Rol">@item.Rol</td>
                            <td data-label="Estado">
                                @if (item.Estado == "A")
                                {
                                    <span class="badge-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-inactivo">Inactivo</span>
                                }
                            </td>
                            <td data-label="Acciones">
                                <div class="acciones-mobile">
                                    <a href="/Usuarios/Editar/@item.Identificador" class="btn-blue">Editar</a>
                                    <a href="/Usuarios/Eliminar/@item.Identificador" class="btn-red"
                                       onclick="return confirm('¿Desea inactivar este usuario?')">Inactivar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>