@model MegaHits506.Models.Usuario
@{
    ViewBag.Title = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card-mega" style="max-width:600px; margin:0 auto">
    <div class="card-head">✏️ Editar Usuario</div>
    <div class="card-body-mega">
        @using (Html.BeginForm("Editar", "Usuarios", FormMethod.Post))
        {
            <input type="hidden" name="Identificador" value="@Model.Identificador" />
            <div class="form-mega">
                <div class="mb-3">
                    <label>Nombre completo *</label>
                    <input type="text" name="NombreCompleto" value="@Model.NombreCompleto" required />
                </div>
                <div class="mb-3">
                    <label>Cédula</label>
                    <input type="text" name="Cedula" value="@Model.Cedula" />
                </div>
                <div class="mb-3">
                    <label>Correo electrónico *</label>
                    <input type="email" name="Correo" value="@Model.Correo" required />
                </div>
                <div class="mb-3">
                    <label>Rol *</label>
                    <select name="RoIdentificador" required>
                        @foreach (var rol in ViewBag.Roles as List<System.Web.Mvc.SelectListItem>)
                        {
                            <option value="@rol.Value"
                                    @(rol.Value == Model.RoIdentificador.ToString() ? "selected" : "")>
                                @rol.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-blue">Guardar cambios</button>
                    <a href="/Usuarios" class="btn-outline">Cancelar</a>
                </div>
            </div>
        }
    </div>
</div>