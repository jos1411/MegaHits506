@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<section class="hero-section">
    <div class="container">
        <img src="/Content/img/LogoDiscoMovil.png"
             alt="Mega Hits 506"
             class="hero-logo" />
        <h1>Mega Hits 506</h1>
        <p>La discomóvil #1 de Pérez Zeledón. Animamos tus eventos con el mejor sonido y energía.</p>
        <div class="hero-buttons">
            <a href="/Home/Eventos" class="btn-blue"
               style="padding:14px 36px;font-size:17px;margin-right:12px">
                Ver Eventos
            </a>
            <a href="/Acceso/Registro"
               style="padding:14px 36px;font-size:17px;color:#fff;
                      border:2px solid #fff;border-radius:var(--radius);
                      text-decoration:none;display:inline-block;
                      transition:all 0.3s">
                Solicitar Cotización
            </a>
        </div>
    </div>
</section>

<section class="stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-numero">5+</div>
                    <div class="stat-label">Años de experiencia</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-numero">50+</div>
                    <div class="stat-label">Eventos realizados</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-numero">100%</div>
                    <div class="stat-label">Clientes satisfechos</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-numero">1</div>
                    <div class="stat-label">Región, Pérez Zeledón</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section style="padding:80px 0;background:var(--bg-primary)">
    <div class="container">
        <h2 style="text-align:center;color:var(--color-blue);
                   margin-bottom:12px;">
            Nuestros Servicios
        </h2>
        <p style="text-align:center;color:var(--text-secondary);
                  margin-bottom:50px;max-width:500px;margin-left:auto;margin-right:auto">
            Música, sonido y animación profesional para asegurar el éxito de su evento.
        </p>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="mision-card" style="text-align:center">
                    <div class="icono">🎤</div>
                    <h4>Animación Profesional</h4>
                    <p>Conducimos su evento con excelente energía y un manejo adecuado del público, adaptando nuestra interacción al protocolo de su actividad.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mision-card" style="text-align:center">
                    <div class="icono">🔊</div>
                    <h4>Sonido de Alta Calidad</h4>
                    <p>Contamos con equipos de audio profesionales que garantizan un sonido claro, potente y bien distribuido, ideal para cualquier tipo de espacio.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mision-card" style="text-align:center">
                    <div class="icono">🎶</div>
                    <h4>Variedad Musical</h4>
                    <p>Diseñamos el ambiente perfecto con un repertorio musical amplio y versátil, ajustado cuidadosamente a los gustos de sus invitados.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section style="padding:80px 0;background:var(--bg-secondary)">
    <div class="container">
        <h2 style="text-align:center;color:var(--color-blue);
                   margin-bottom:12px;">
            Sobre Nosotros
        </h2>
        <p style="text-align:center;color:var(--text-secondary);
                  margin-bottom:50px">
            Conozca quiénes somos y qué nos mueve
        </p>

        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="mision-card">
                    <div class="icono">🎯</div>
                    <h4>Nuestra Misión</h4>
                    <p>
                        Brindar una gran experiencia de entretenimiento mediante la mejora continua
                        de nuestras ofertas y la utilización de equipo de alta calidad, priorizando
                        siempre la satisfacción del consumidor.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mision-card">
                    <div class="icono">🚀</div>
                    <h4>Nuestra Visión</h4>
                    <p>
                        Ser el proveedor de entretenimiento y sonido líder en Pérez Zeledón,
                        escalando a eventos de mayor envergadura mientras se mantiene la
                        satisfacción total del cliente.
                    </p>
                </div>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <h4 style="color:var(--color-blue);margin-bottom:24px">
                    📖 Nuestra Trayectoria
                </h4>
                <div class="historia-timeline">
                    <div class="historia-item">
                        <h6>Orígenes y Fundación</h6>
                        <p>Mega Hits 506 nace en Pérez Zeledón con la visión de profesionalizar el entretenimiento regional, ofreciendo soluciones de audio y animación de alta calidad.</p>
                    </div>
                    <div class="historia-item">
                        <h6>Vinculación Social</h6>
                        <p>Consolidamos nuestra presencia mediante el apoyo técnico en diversos eventos sociales y culturales, logrando un fuerte reconocimiento por nuestra seriedad y cumplimiento.</p>
                    </div>
                    <div class="historia-item">
                        <h6>Especialización en Eventos Masivos</h6>
                        <p>Nos convertimos en referentes para el manejo de sonido en actividades de gran convocatoria al aire libre, perfeccionando nuestra logística y despliegue técnico.</p>
                    </div>
                    <div class="historia-item">
                        <h6>Consolidación Operativa</h6>
                        <p>La ejecución exitosa de proyectos en escenarios de gran envergadura ha reafirmado nuestra capacidad para gestionar producciones complejas con resultados impecables.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-center">
                <div style="background:var(--bg-card);border-radius:var(--radius-lg);
                            padding:40px;border:1px solid var(--border-color)">
                    <img src="/Content/img/LogoDiscoMovil.png"
                         alt="Mega Hits 506"
                         style="width:120px;height:120px;object-fit:contain;
                                border-radius:12px;margin-bottom:20px"
                         loading="lazy" />
                    <h4 style="color:var(--color-blue);margin-bottom:12px">
                        Pérez Zeledón, Costa Rica
                    </h4>
                    <p style="color:var(--text-secondary)">
                        📍 Arenilla de San Pedro
                    </p>
                    <p style="color:var(--text-secondary);margin-top:12px">
                        Comprometidos con la excelencia técnica y la creación de experiencias memorables en cada uno de nuestros eventos.
                    </p>
                    <a href="/Home/Contact" class="btn-blue"
                       style="margin-top:20px;display:inline-block">
                        Contáctenos
                    </a> 
                </div>
            </div>
        </div>
    </div>
</section>

<section style="padding:80px 0;background:var(--color-blue);text-align:center">
    <div class="container">
        <h2 style="color:#fff;margin-bottom:16px;">
            ¿Listo para contratar?
        </h2>
        <p style="color:rgba(255,255,255,0.85);margin-bottom:30px;font-size:17px">
            Contáctenos directamente por WhatsApp y coordinamos su evento.
        </p>
        <a href="https://wa.me/50687660242" target="_blank"
           style="background:#25d366;color:#fff;border:none;
                  border-radius:var(--radius);padding:14px 36px;
                  font-size:17px;text-decoration:none;
                  display:inline-block;transition:background 0.3s">
            💬 Escríbanos por WhatsApp
        </a>
    </div>
</section> 