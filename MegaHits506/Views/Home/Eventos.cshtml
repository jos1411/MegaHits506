@model List<MegaHits506.Models.Evento>
@using System.Linq
@{
    ViewBag.Title = "Eventos";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<div style="background:linear-gradient(135deg,#1a1a2a 0%,var(--color-blue) 100%);
            padding:60px 0;text-align:center;color:#fff">
    <h1 style="font-size:42px">📅 Eventos</h1>
    <p style="opacity:.85">Conocé los eventos donde hemos participado</p>
</div>

<section style="padding:60px 0;background:var(--bg-primary)">
    <div class="container">
        @if (!Model.Any())
        {
            <div style="text-align:center;padding:60px 0;color:var(--text-secondary)">
                <p style="font-size:18px">Próximamente eventos disponibles.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="card-mega">
                            @if (!string.IsNullOrEmpty(item.ImagenPortada))
                            {
                                <img src="@item.ImagenPortada" alt="@item.Titulo"
                                     style="width:100%;height:200px;object-fit:cover"
                                     onerror="this.style.display='none'" />
                            }
                            else
                            {
                                <div style="width:100%;height:200px;background:var(--bg-secondary);
                                            display:flex;align-items:center;justify-content:center;
                                            font-size:48px">🎵</div>
                            }
                            <div class="card-body-mega">
                                <h5 style="color:var(--color-blue);margin-bottom:8px">@item.Titulo</h5>
                                <p style="color:var(--text-secondary);font-size:13px;margin-bottom:4px">
                                    📅 @(item.FechaEvento.HasValue ?
                                        item.FechaEvento.Value.ToString("dd/MM/yyyy") :
                                        "Fecha por confirmar")
                                </p>
                                <p style="color:var(--text-secondary);font-size:13px;margin-bottom:12px">
                                    📍 @item.Ubicacion
                                </p>
                                <p style="color:var(--text-secondary);font-size:14px;margin-bottom:16px">
                                    @item.Descripcion
                                </p>
                                <a href="/Home/DetalleEvento/@item.Identificador"
                                   class="btn-blue" style="font-size:13px">
                                    Ver detalle →
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>