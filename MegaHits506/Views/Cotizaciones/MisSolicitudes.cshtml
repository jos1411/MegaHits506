@model List<MegaHits506.Models.Cotizacion>
@{
    ViewBag.Title = "Mis Solicitudes";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<section style="padding:60px 0;background:var(--bg-secondary)">
    <div class="container">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert-mega success mb-4">@TempData["Mensaje"]</div>
        }

        <div class="card-mega">
            <div class="card-head">📋 Mis Solicitudes de Cotización</div>
            <div class="card-body-mega">
                @if (Model.Count == 0)
                {
                    <div style="text-align:center;padding:40px 0">
                        <p style="color:var(--text-secondary);margin-bottom:20px">
                            No tenés solicitudes enviadas todavía.
                        </p>
                        <a href="/Cotizaciones/Solicitar" class="btn-blue">
                            Solicitar cotización
                        </a>
                    </div>
                }
                else
                {
                    <table class="table-mega">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tipo de evento</th>
                                <th>Fecha deseada</th>
                                <th>Enviada</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Identificador</td>
                                    <td>@item.TipoEvento</td>
                                    <td>@item.FechaEventoDeseada.ToString("dd/MM/yyyy")</td>
                                    <td>@item.FechaAdicion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.EstadoSolicitud == "PENDIENTE")
                                        {
                                            <span class="badge-pendiente">PENDIENTE</span>
                                        }
                                        else if (item.EstadoSolicitud == "ATENDIDO")
                                        {
                                            <span class="badge-atendido">ATENDIDO</span>
                                        }
                                        else
                                        {
                                            <span class="badge-cancelado">CANCELADO</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</section>