@{
    ViewBag.Title = "Solicitar Cotización";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<section style="padding:60px 0;background:var(--bg-secondary)">
    <div class="container" style="max-width:650px">
        <div class="card-mega">
            <div class="card-head">📋 Solicitar Cotización</div>
            <div class="card-body-mega">
                <p style="color:var(--text-secondary);margin-bottom:24px">
                    Completá el formulario y nos pondremos en contacto para coordinar tu evento.
                </p>

                @using (Html.BeginForm("Solicitar", "Cotizaciones", FormMethod.Post))
                {
                    <div class="form-mega">
                        <div class="mb-3">
                            <label>Tipo de evento *</label>
                            <select name="TipoEvento" required>
                                <option value="">-- Seleccione --</option>
                                <option value="Boda">💍 Boda</option>
                                <option value="Quinceañera">🎀 Quinceañera</option>
                                <option value="Cabalgata">🐴 Cabalgata</option>
                                <option value="Actividad religiosa">⛪ Actividad religiosa</option>
                                <option value="Fiesta privada">🎉 Fiesta privada</option>
                                <option value="Evento corporativo">🏢 Evento corporativo</option>
                                <option value="Otro">📌 Otro</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Fecha deseada del evento *</label>
                            <input type="date" name="FechaEventoDeseada" required />
                        </div>
                        <div class="mb-3">
                            <label>Teléfono de contacto *</label>
                            <input type="text" name="TelefonoCliente"
                                   placeholder="Ej: 8888-8888" required />
                        </div>
                        <div class="mb-3">
                            <label>Detalles adicionales</label>
                            <textarea name="Detalles" rows="4"
                                      placeholder="Contanos más: lugar, cantidad de personas, tipo de música..."></textarea>
                        </div>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn-blue"
                                    style="padding:12px 32px">
                                Enviar solicitud
                            </button>
                            <a href="/Home/Index" class="btn-outline"
                               style="padding:12px 32px">Cancelar</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>