@model List<MegaHits506.Models.Cotizacion>
@{
    ViewBag.Title = "Cotizaciones";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert-mega success mb-4">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-mega error mb-4">@TempData["Error"]</div>
}

<div class="card-mega">
    <div class="card-head">📋 Solicitudes de Cotización</div>
    <div class="card-body-mega">
        <div class="tabla-admin-wrapper">
            <table class="table-mega">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Tipo de evento</th>
                        <th>Fecha deseada</th>
                        <th>Recibida</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="#">@item.Identificador</td>
                            <td data-label="Cliente">@item.Cliente</td>
                            <td data-label="Teléfono">@item.TelefonoCliente</td>
                            <td data-label="Tipo">@item.TipoEvento</td>
                            <td data-label="Fecha deseada">@item.FechaEventoDeseada.ToString("dd/MM/yyyy")</td>
                            <td data-label="Recibida">@item.FechaAdicion.ToString("dd/MM/yyyy")</td>
                            <td data-label="Estado">
                                @if (item.EstadoSolicitud == "PENDIENTE")
                                {
                                    <span class="badge-pendiente">PENDIENTE</span>
                                }
                                else if (item.EstadoSolicitud == "ATENDIDO")
                                {
                                    <span class="badge-atendido">ATENDIDO</span>
                                }
                                else
                                {
                                    <span class="badge-cancelado">CANCELADO</span>
                                }
                            </td>
                            <td data-label="Acciones">
                                <div class="acciones-mobile">
                                    <a href="/Cotizaciones/Detalle/@item.Identificador" class="btn-blue">Ver</a>
                                    <a href="/Cotizaciones/Eliminar/@item.Identificador" class="btn-red"
                                       onclick="return confirm('¿Desea eliminar esta solicitud?')">Eliminar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>