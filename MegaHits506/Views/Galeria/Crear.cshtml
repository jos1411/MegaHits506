@model MegaHits506.Models.Galeria
@{
    ViewBag.Title = "Agregar a Galería";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string tipoActual = Model != null ? Model.Tipo : "";
}

<div class="card-mega" style="max-width:650px; margin:0 auto">
    <div class="card-head">🖼️ Agregar a Galería</div>
    <div class="card-body-mega">

        @if (ViewBag.Error != null)
        {
            <div class="alert-mega error mb-3">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Crear", "Galeria", FormMethod.Post,
                new { enctype = "multipart/form-data" }))
        {
            <input type="hidden" name="Url" id="urlFinal" value="" />

            <div class="form-mega">
                <div class="mb-3">
                    <label>Evento *</label>
                    <select name="EvIdentificador" required>
                        <option value="">-- Seleccione un evento --</option>
                        @foreach (var ev in ViewBag.Eventos as List<MegaHits506.Models.Evento>)
                        {
                            <option value="@ev.Identificador"
                                    @(Model != null && ev.Identificador == Model.EvIdentificador ? "selected" : "")>
                                @ev.Titulo
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label>Tipo *</label>
                    <select name="Tipo" id="selectTipo" required
                            onchange="mostrarCampos(this.value)">
                        <option value="">-- Seleccione tipo --</option>
                        <option value="FOTO" @(tipoActual == "FOTO" ? "selected" : "")>📷 FOTO</option>
                        <option value="VIDEO" @(tipoActual == "VIDEO" ? "selected" : "")>🎬 VIDEO</option>
                    </select>
                </div>

                <!-- FOTO: solo subida de archivo -->
                <div id="campoFoto" style="display:@(tipoActual == "FOTO" ? "block" : "none")">
                    <div class="mb-3">
                        <label>Seleccionar foto *</label>
                        <input type="file" name="archivoFoto" id="archivoFoto"
                               accept="image/*"
                               style="background:var(--bg-secondary);border:1px solid var(--border-color);
                                      color:var(--text-primary);border-radius:var(--radius);
                                      padding:8px;width:100%"
                               onchange="previewImagen(this)" />
                        <img id="preview" src="" alt="Vista previa"
                             style="max-width:100%;border-radius:var(--radius);
                                    margin-top:10px;display:none;max-height:200px;object-fit:cover" />
                        <small style="color:var(--text-secondary)">
                            Formatos: JPG, PNG, GIF, WEBP. Máximo 10MB.
                        </small>
                    </div>
                </div>

                <!-- VIDEO: URL de YouTube -->
                <div id="campoVideo" style="display:@(tipoActual == "VIDEO" ? "block" : "none")">
                    <div class="mb-3">
                        <label>URL de YouTube *</label>
                        <input type="text" id="urlVideo"
                               value="@(tipoActual == "VIDEO" && Model != null ? Model.Url : "")"
                               placeholder="https://www.youtube.com/watch?v=..."
                               oninput="document.getElementById('urlFinal').value = this.value" />
                        <small style="color:var(--text-secondary)">
                            Pegá el enlace normal de YouTube. Se convierte automáticamente.
                        </small>
                    </div>
                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea name="Descripcion" rows="2"
                              placeholder="Descripción opcional...">@(Model != null ? Model.Descripcion : "")</textarea>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-blue">Guardar</button>
                    <a href="/Galeria" class="btn-outline">Cancelar</a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function mostrarCampos(tipo) {
        document.getElementById('campoFoto').style.display = tipo === 'FOTO' ? 'block' : 'none';
        document.getElementById('campoVideo').style.display = tipo === 'VIDEO' ? 'block' : 'none';
        document.getElementById('urlFinal').value = '';
    }

    function previewImagen(input) {
        var preview = document.getElementById('preview');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    window.onload = function () {
        var tipo = document.getElementById('selectTipo').value;
        if (tipo === 'VIDEO') {
            var v = document.getElementById('urlVideo');
            if (v) document.getElementById('urlFinal').value = v.value;
        }
    };
</script>