<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mega Hits 506</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/css/lightbox.min.css" rel="stylesheet" />
</head>
<body>

    <nav class="navbar navbar-mega navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/Home/Index">🎵 Mega Hits 506</a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navPublico">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navPublico">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath == "/Home/Index" || Request.Url.AbsolutePath == "/" ? "active" : "")"
                           href="/Home/Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Home/Eventos") ? "active" : "")"
                           href="/Home/Eventos">Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Home/Galeria") ? "active" : "")"
                           href="/Home/Galeria">Galería</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Home/Contact") ? "active" : "")"
                           href="/Home/Contact">Contacto</a>
                    </li>
                    @if (Session["UsuarioId"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Cotizaciones/Solicitar">Cotizar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Cotizaciones/MisSolicitudes">Mis Solicitudes</a>
                        </li>
                        if (Session["UsuarioRol"].ToString() == "Administrador")
                        {
                            <li class="nav-item ms-2">
                                <a class="btn-blue" href="/Eventos">Panel Admin</a>
                            </li>
                        }
                        <li class="nav-item ms-2">
                            <a class="nav-link" href="/Acceso/CerrarSesion">Cerrar sesión</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-2">
                            <a class="nav-link" href="/Acceso/Registro">Registrarse</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn-blue" href="/Acceso/Login">Iniciar sesión</a>
                        </li>
                    }
                    <li class="nav-item ms-2">
                        <button class="dark-toggle" onclick="toggleDark()" title="Modo oscuro">🌙</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-publico">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>🎵 Mega Hits 506</h5>
                    <p>
                        Discomóvil profesional en Pérez Zeledón, Costa Rica.
                        Animamos tus eventos con el mejor sonido y energía.
                    </p>
                </div>
                <div class="col-md-4">
                    <h5>Navegación</h5>
                    <a href="/Home/Index">Inicio</a>
                    <a href="/Home/Eventos">Eventos</a>
                    <a href="/Home/Galeria">Galería</a>
                    <a href="/Home/Contact">Contacto</a>
                </div>
                <div class="col-md-4">
                    <h5>Contacto</h5>
                    <p>📍 Arenilla de San Pedro, Pérez Zeledón</p>
                    <p>
                        💬 <a href="https://wa.me/50687660242"
                              target="_blank">+506 8766-0242</a>
                    </p>
                    <a href="/Cotizaciones/Solicitar"
                       style="background:var(--color-blue);color:#fff;
                          padding:8px 20px;border-radius:var(--radius);
                          margin-top:8px;display:inline-block">
                        Solicitar Cotización
                    </a>
                </div>
            </div>
            <div class="footer-copy">
                <p>
                    © 2026 <span>Mega Hits 506</span> —
                    Pérez Zeledón, Costa Rica. Todos los derechos reservados.
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modo oscuro
        function toggleDark() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('darkMode',
                document.body.classList.contains('dark-mode') ? '1' : '0');
        }
        if (localStorage.getItem('darkMode') === '1') {
            document.body.classList.add('dark-mode');
        }
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.4/js/lightbox.min.js"></script>
    <script>
        lightbox.option({
            'resizeDuration': 200,
            'wrapAround': true,
            'albumLabel': 'Foto %1 de %2'
        });
    </script>

</body>
</html>