<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mega Hits 506</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>

    <nav class="navbar navbar-mega navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/Home/Index">🎵 Mega Hits 506</a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navPublico">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navPublico">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Eventos">Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Galeria">Galería</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Contact">Contacto</a>
                    </li>
                    @if (Session["UsuarioId"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Cotizaciones/Solicitar">Cotizar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Cotizaciones/MisSolicitudes">Mis Solicitudes</a>
                        </li>
                        if (Session["UsuarioRol"].ToString() == "Administrador")
                        {
                            <li class="nav-item ms-2">
                                <a class="btn-blue" href="/Eventos">Panel Admin</a>
                            </li>
                        }
                        <li class="nav-item ms-2">
                            <a class="nav-link" href="/Acceso/CerrarSesion">Cerrar sesión</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-2">
                            <a class="nav-link" href="/Acceso/Registro">Registrarse</a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn-blue" href="/Acceso/Login">Iniciar sesión</a>
                        </li>
                    }
                    <li class="nav-item ms-2">
                        <button class="dark-toggle" onclick="toggleDark()" title="Modo oscuro">🌙</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-mega">
        <p>© 2026 <span>Mega Hits 506</span> — Pérez Zeledón, Costa Rica.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modo oscuro
        function toggleDark() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('darkMode',
                document.body.classList.contains('dark-mode') ? '1' : '0');
        }
        if (localStorage.getItem('darkMode') === '1') {
            document.body.classList.add('dark-mode');
        }
    </script>
</body>
</html>