<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin | Mega Hits 506</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css?v=3" rel="stylesheet" />
</head>
<body>

    <nav class="navbar navbar-mega navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Eventos">
                <img src="/Content/img/LogoDiscoMovil.png"
                     alt="Mega Hits 506"
                     class="navbar-logo" />
                Mega Hits 506
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navAdmin">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navAdmin">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Eventos") ? "active" : "")"
                           href="/Eventos">Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Galeria") ? "active" : "")"
                           href="/Galeria">Galería</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Usuarios") ? "active" : "")"
                           href="/Usuarios">Usuarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Cotizaciones") ? "active" : "")"
                           href="/Cotizaciones">Cotizaciones</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Request.Url.AbsolutePath.StartsWith("/Home/About") ? "active" : "")"
                           href="/Home/About">Ayuda</a>
                    </li>
                    <li class="nav-item ms-2">
                        <a class="nav-link" href="/Home/Index">Ver sitio</a>
                    </li>
                    <li class="nav-item ms-2">
                        <a class="btn-red" href="/Acceso/CerrarSesion">Cerrar sesión</a>
                    </li>
                    <li class="nav-item ms-2">
                        <button class="dark-toggle" onclick="toggleDark()" title="Modo oscuro">🌙</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4">
        @RenderBody()
    </div>

    <footer class="footer-mega">
        <p>© 2026 <span>Mega Hits 506</span> — Panel Administrativo</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleDark() {
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('darkMode',
                document.body.classList.contains('dark-mode') ? '1' : '0');
        }
        if (localStorage.getItem('darkMode') === '1') {
            document.body.classList.add('dark-mode');
        }
    </script>
</body>
</html>
