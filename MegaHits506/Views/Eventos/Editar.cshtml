@model MegaHits506.Models.Evento
@{
    ViewBag.Title = "Editar Evento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card-mega" style="max-width:650px; margin:0 auto">
    <div class="card-head">✏️ Editar Evento</div>
    <div class="card-body-mega">

        @if (ViewBag.Error != null)
        {
            <div class="alert-mega error mb-3">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Editar", "Eventos", FormMethod.Post,
                new { enctype = "multipart/form-data" }))
        {
            <input type="hidden" name="Identificador" value="@Model.Identificador" />

            <div class="form-mega">
                <div class="mb-3">
                    <label>Título *</label>
                    <input type="text" name="Titulo" value="@Model.Titulo" required />
                </div>
                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea name="Descripcion" rows="3">@Model.Descripcion</textarea>
                </div>
                <div class="mb-3">
                    <label>Fecha del evento</label>
                    <input type="datetime-local" name="FechaEvento"
                           value="@(Model.FechaEvento.HasValue ? Model.FechaEvento.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                </div>
                <div class="mb-3">
                    <label>Ubicación</label>
                    <input type="text" name="Ubicacion" value="@Model.Ubicacion" />
                </div>
                <div class="mb-3">
                    <label>Imagen de portada</label>
                    <input type="file" name="archivoPortada" accept="image/*"
                           style="background:var(--bg-secondary);border:1px solid var(--border-color);
                                  color:var(--text-primary);border-radius:var(--radius);
                                  padding:8px;width:100%"
                           onchange="previewPortada(this)" />
                    @if (!string.IsNullOrEmpty(Model.ImagenPortada))
                    {
                        <img src="@Model.ImagenPortada" alt="Portada actual"
                             id="previewImg"
                             style="max-width:100%;border-radius:var(--radius);
                                    margin-top:8px;max-height:150px;object-fit:cover"
                             onerror="this.style.display='none'" />
                    }
                    else
                    {
                        <img id="previewImg" src="" style="display:none;max-width:100%;
                             border-radius:var(--radius);margin-top:8px;max-height:150px;object-fit:cover" />
                    }
                    <small style="color:var(--text-secondary);display:block;margin-top:6px">
                        O pegá una URL de imagen
                    </small>
                    <input type="text" name="ImagenPortada" value="@Model.ImagenPortada"
                           placeholder="https://..." style="margin-top:6px" />
                    <small style="color:var(--text-secondary)">
                        Si subís un archivo nuevo, reemplaza la imagen actual.
                    </small>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-blue">Guardar cambios</button>
                    <a href="/Eventos" class="btn-outline">Cancelar</a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function previewPortada(input) {
        var preview = document.getElementById('previewImg');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>