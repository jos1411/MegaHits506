@model MegaHits506.Models.Evento
@{
    ViewBag.Title = "Editar Evento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string fechaVal = Model.FechaEvento.HasValue
                      ? Model.FechaEvento.Value.ToString("yyyy-MM-ddTHH:mm") : "";
    bool tienePortada = !string.IsNullOrEmpty(Model.ImagenPortada);
}

<div class="card-mega" style="max-width:650px; margin:0 auto">
    <div class="card-head">✏️ Editar Evento</div>
    <div class="card-body-mega">

        @if (ViewBag.Error != null)
        {
            <div class="alert-mega error mb-3">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Editar", "Eventos", FormMethod.Post,
                new { enctype = "multipart/form-data" }))
        {
            <input type="hidden" name="Identificador" value="@Model.Identificador" />
            <input type="hidden" name="ImagenPortada" value="@Model.ImagenPortada" />

            <div class="form-mega">
                <div class="mb-3">
                    <label>Título *</label>
                    <input type="text" name="Titulo" value="@Model.Titulo" required />
                </div>
                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea name="Descripcion" rows="3">@Model.Descripcion</textarea>
                </div>
                <div class="mb-3">
                    <label>Fecha del evento</label>
                    <input type="datetime-local" name="FechaEvento" value="@fechaVal" />
                </div>
                <div class="mb-3">
                    <label>Ubicación</label>
                    <input type="text" name="Ubicacion" value="@Model.Ubicacion" />
                </div>
                <div class="mb-3">
                    <label>Imagen de portada</label>
                    <input type="file" name="archivoPortada" accept="image/*"
                           style="background:var(--bg-secondary);
                                  border:1px solid var(--border-color);
                                  color:var(--text-primary);
                                  border-radius:var(--radius);
                                  padding:8px;width:100%"
                           onchange="previewPortada(this)" />
                    @if (tienePortada)
                    {
                        <div style="margin-top:10px">
                            <small style="color:var(--text-secondary)">Portada actual:</small>
                            <img src="@Model.ImagenPortada" id="previewImg"
                                 alt="Portada actual"
                                 style="max-width:100%;border-radius:var(--radius);
                                        margin-top:6px;max-height:150px;
                                        object-fit:cover;display:block"
                                 onerror="this.style.display='none'" />
                        </div>
                    }
                    else
                    {
                        <img id="previewImg" src="" alt="Vista previa"
                             style="display:none;max-width:100%;border-radius:var(--radius);
                                    margin-top:8px;max-height:150px;object-fit:cover" />
                    }
                    <small style="color:var(--text-secondary)">
                        Si subís una imagen nueva, reemplaza la actual. Máximo 10MB.
                    </small>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-blue">Guardar cambios</button>
                    <a href="/Eventos" class="btn-outline">Cancelar</a>
                </div>
            </div>
        }

    </div>
</div>

<script>
    function previewPortada(input) {
        var preview = document.getElementById('previewImg');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>