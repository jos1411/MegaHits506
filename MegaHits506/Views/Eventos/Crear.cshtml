@model MegaHits506.Models.Evento
@{
    ViewBag.Title = "Nuevo Evento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string tituloVal = Model != null ? Model.Titulo : "";
    string descVal = Model != null ? Model.Descripcion : "";
    string ubicVal = Model != null ? Model.Ubicacion : "";
    string fechaVal = Model != null && Model.FechaEvento.HasValue
                          ? Model.FechaEvento.Value.ToString("yyyy-MM-ddTHH:mm") : "";
}

<div class="card-mega" style="max-width:650px; margin:0 auto">
    <div class="card-head">📅 Nuevo Evento</div>
    <div class="card-body-mega">

        @if (ViewBag.Error != null)
        {
            <div class="alert-mega error mb-3">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Crear", "Eventos", FormMethod.Post,
                new { enctype = "multipart/form-data" }))
        {
            <div class="form-mega">
                <div class="mb-3">
                    <label>Título *</label>
                    <input type="text" name="Titulo" value="@tituloVal" required />
                </div>
                <div class="mb-3">
                    <label>Descripción</label>
                    <textarea name="Descripcion" rows="3">@descVal</textarea>
                </div>
                <div class="mb-3">
                    <label>Fecha del evento</label>
                    <input type="datetime-local" name="FechaEvento" value="@fechaVal" />
                </div>
                <div class="mb-3">
                    <label>Ubicación</label>
                    <input type="text" name="Ubicacion" value="@ubicVal" />
                </div>
                <div class="mb-3">
                    <label>Imagen de portada</label>
                    <input type="file" name="archivoPortada" accept="image/*"
                           style="background:var(--bg-secondary);
                                  border:1px solid var(--border-color);
                                  color:var(--text-primary);
                                  border-radius:var(--radius);
                                  padding:8px;width:100%"
                           onchange="previewPortada(this)" />
                    <img id="previewImg" src="" alt="Vista previa"
                         style="max-width:100%;border-radius:var(--radius);
                                margin-top:10px;display:none;
                                max-height:200px;object-fit:cover" />
                    <small style="color:var(--text-secondary)">
                        Formatos: JPG, PNG, GIF, WEBP. Máximo 10MB.
                    </small>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn-blue">Guardar</button>
                    <a href="/Eventos" class="btn-outline">Cancelar</a>
                </div>
            </div>
        }

    </div>
</div>

<script>
    function previewPortada(input) {
        var preview = document.getElementById('previewImg');
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>